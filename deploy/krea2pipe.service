[Unit]
Description=Krea2 renderer and local image API
After=local-fs.target nvidia-persistenced.service
Wants=nvidia-persistenced.service
RequiresMountsFor=/data/krea2 /data/ComfyUI/models
OnFailure=krea2pipe-retry.service
ConditionPathExists=/data/krea2/krea2pipe.toml
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=azadmin
Group=azadmin
WorkingDirectory=/data/krea2
Environment=HOME=/data/krea2
Environment=PYTHONUNBUFFERED=1
# Cache compiled CUDA kernels across service and machine restarts.
Environment=TORCHINDUCTOR_CACHE_DIR=/var/cache/krea2pipe/inductor
CacheDirectory=krea2pipe
# Initialize Unified Virtual Memory before NoNewPrivileges blocks the setuid helper.
ExecStartPre=+/usr/bin/nvidia-modprobe -u
# If the previous run crashed, the Inductor compile cache may contain
# truncated entries (e.g. EOFError/AttributeError on stale kernels).
# Purge it before starting again so a bad cache can't wedge restarts.
ExecStartPre=/bin/sh -c 'if [ -e /var/cache/krea2pipe/.inductor-cache-dirty ]; then rm -rf /var/cache/krea2pipe/inductor/*; rm -f /var/cache/krea2pipe/.inductor-cache-dirty; fi'
ExecStart=/data/krea2/.venv/bin/krea2pipe --config /data/krea2/krea2pipe.toml
ExecStopPost=/bin/sh -c 'if [ "$SERVICE_RESULT" != "success" ]; then touch /var/cache/krea2pipe/.inductor-cache-dirty; fi'
Restart=on-failure
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=30
SuccessExitStatus=130 SIGINT
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/data/ComfyUI/models
ReadWritePaths=/data/krea2

[Install]
WantedBy=multi-user.target
