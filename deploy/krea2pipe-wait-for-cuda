#!/bin/sh
set -eu

python=/data/krea2/.venv/bin/python
attempt=1
max_attempts=20

# A failed PyTorch CUDA probe is cached for that process, so retry in fresh
# processes while the NVIDIA UVM device finishes initializing after boot.
while [ "${attempt}" -lt "${max_attempts}" ]; do
    if "${python}" -c 'import torch; torch.cuda.init()' >/dev/null 2>&1; then
        exit 0
    fi
    attempt=$((attempt + 1))
    sleep 1
done

printf 'CUDA did not become ready after %s PyTorch probes\n' "${max_attempts}" >&2
exec "${python}" -c 'import torch; torch.cuda.init()'
